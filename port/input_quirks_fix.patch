+// FIX(5): keyboard messages that ImGui needs while the tuning panel is open.
+// The original subclass proc only forwarded mouse messages; keyboard input
+// relied entirely on the GetAsyncKeyState/GetKeyboardState IAT hooks which
+// are not installed when HandleImGuiWndProc is not the IAT path being used.
+// Route WM_KEY* and WM_CHAR* through HandleImGuiWndProc so the ImGui panel
+// can receive typed input regardless of IAT hook availability.
+static bool IsKeyboardMessage(UINT msg)
+{
+    switch (msg)
+    {
+    case WM_KEYDOWN:
+    case WM_KEYUP:
+    case WM_SYSKEYDOWN:
+    case WM_SYSKEYUP:
+    case WM_CHAR:
+    case WM_SYSCHAR:
+    case WM_DEADCHAR:
+    case WM_SYSDEADCHAR:
+        return true;
+    default:
+        return false;
+    }
+}
